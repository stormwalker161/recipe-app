EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Gemini calls are routed through a Cloudflare Worker proxy (server/gemini-proxy)
# that holds the real API key server-side as a secret. No Gemini key belongs here.
EXPO_PUBLIC_GEMINI_PROXY_URL=
# Personal access token from https://expo.dev/accounts/[username]/settings/access-tokens
# Only needed locally to run `eas build` without an interactive login.
EXPO_TOKEN=
